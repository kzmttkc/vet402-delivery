{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kzmttkc/vet402-check",
  "title": "vet402-check",
  "description": "Before your agent pays an x402 API, check if vet402 bought it with its own money and what came back.",
  "repository": {
    "url": "https://github.com/kzmttkc/vet402-delivery",
    "source": "github",
    "subfolder": "packages/check"
  },
  "websiteUrl": "https://kzmttkc.github.io/vet402-delivery/use.html",
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@vet402/check",
      "version": "0.2.0",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "--mcp", "isRequired": true, "description": "Serve the MCP tools over stdio" }
      ]
    }
  ]
}
