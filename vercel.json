{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "",
  "outputDirectory": "site",
  "rewrites": [
    { "source": "/v1/check", "destination": "/api/check" },
    { "source": "/v1/buy", "destination": "/api/buy" },
    { "source": "/v1/buy/records/:id", "destination": "/api/buy?record=:id" }
  ],
  "functions": {
    "api/buy.ts": { "maxDuration": 300, "includeFiles": "data/**" },
    "api/reconcile.ts": { "maxDuration": 300, "includeFiles": "data/**" },
    "api/alerts.ts": { "maxDuration": 30 },
    "api/check.ts": { "maxDuration": 10, "includeFiles": "{site/rank.json,data/records/index.json,data/evm/*.json}" },
    "api/usage.ts": { "maxDuration": 10 }
  },
  "crons": [{ "path": "/api/reconcile", "schedule": "*/5 * * * *" }]
}
