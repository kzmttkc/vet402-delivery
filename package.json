{
  "name": "vet402-solana",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "vet402 on Solana: Colosseum gate 1 (PayAI-only sellers, settle-and-deliver check)",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts packages/check/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "gate1": "tsx scripts/gate1.ts",
    "census": "tsx scripts/census.ts",
    "tempo-census": "tsx scripts/tempo-census.ts",
    "check": "tsx scripts/vet402-check.ts",
    "erc8004:simulate": "tsx scripts/erc8004-simulate.ts --out results/erc8004-simulate.json",
    "base:buy:dry": "tsx scripts/base-buy.ts --dry-run",
    "base:feedback:dry": "tsx scripts/base-feedback.ts --dry-run --input results/base-buy-dryrun.json",
    "erc8004:feedback": "tsx scripts/erc8004-feedback.ts",
    "rank": "tsx scripts/rank.ts",
    "receipts:keygen": "tsx scripts/receipt-keygen.ts",
    "receipts:build": "tsx scripts/build-receipts.ts",
    "verify-receipt": "tsx scripts/verify-receipt.ts",
    "records:publish": "tsx scripts/publish-records.ts",
    "receipts:anchor": "tsx scripts/anchor-receipts.ts",
    "first-buyer": "tsx scripts/first-buyer.ts",
    "remeasure": "tsx scripts/remeasure.ts",
    "check-before-paying": "node packages/check/bin/vet402-check.mjs",
    "proxy-buy": "tsx scripts/proxy-buy-serve.ts",
    "proxy-buy:reconcile": "tsx scripts/proxy-buy-reconcile.ts",
    "proxy-buy:resolve": "tsx scripts/proxy-buy-resolve.ts",
    "program:build": "cargo-build-sbf --arch v3 --manifest-path solana-program/programs/observation-roots/Cargo.toml && cargo-build-sbf --arch v3 --manifest-path solana-program/programs/delivery-gate-example/Cargo.toml && cargo-build-sbf --arch v3 --manifest-path solana-program/programs/delivery-escrow-example/Cargo.toml",
    "program:test": "node --import tsx --test solana-program/tests/*.test.ts",
    "program:test:mainnet-features": "ROOTS_FEATURES_FROM=https://api.mainnet-beta.solana.com node --import tsx --test solana-program/tests/*.test.ts",
    "program:devnet": "tsx scripts/roots-devnet.ts"
  },
  "bin": {
    "vet402-check": "packages/check/bin/vet402-check.mjs"
  },
  "exports": {
    "./check": "./packages/check/src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "packages/check/bin",
    "packages/check/src",
    "packages/check/README.md",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Sen",
  "dependencies": {
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/fetch": "2.27.0",
    "@x402/svm": "2.27.0",
    "mppx": "0.11.0",
    "pg": "8.23.0",
    "tsx": "4.23.15",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
