.keys/
.env*
node_modules/
results/census-*.dry-run.json
.cache/
results/receipts/
results/solana-feedback-*.json
results/erc8004-feedback-*.json
.scratch/
contracts/out/
contracts/cache/
results/proxy-buy/
# results/ is local run output. Tracked (and read by the secret gate) are only the six files re-included below,
# dry-run and simulation fixtures that docs/erc8004.md and test/ read; test/daily.test.ts pins the list. Other
# results/ paths named in docs/ (ledgers, receipts, run plans) are where a run writes on the runner's machine and
# are not in this repository; a public copy of such a result goes to data/ through the gate.
results/*
!results/base-buy-dryrun.json
!results/base-feedback-dryrun.json
!results/erc8004-simulate.json
!results/evm/
results/evm/*
!results/evm/arbitrum-dryrun.json
!results/evm/robinhood-dryrun.json
!results/evm/declared-inputs.jsonl
